    def _refresh_scene_list_indicators(self):
        """Refresh scene list widget indicators based on analysis states.

        RB3.8C1: Restored full indicator support.
        - RUNNING = Blue indicator
        - SUCCESS = Green indicator
        - FAIL = Red indicator
        """
        if not hasattr(self, 'scene_list_widget') or not hasattr(self, 'scene_list'):
            return
        for i in range(min(self.scene_list_widget.count(), len(self.scene_list))):
            scene = self.scene_list[i]
            scene_id = scene.get('id', scene.get('source_scene_id', ''))
            state = self._scene_analysis_states.get(scene_id, "unanalyzed")
            item = self.scene_list_widget.item(i)
            if item:
                text = item.text()
                # Remove all indicators first
                clean_text = text
                for tag in [" [RUNNING]", " [OK]", " [FAIL]"]:
                    if tag in clean_text:
                        clean_text = clean_text.replace(tag, "")
                
                if state == "running":
                    item.setText(clean_text + " [RUNNING]")
                    item.setForeground(QColor("#4488ff"))  # Blue
                elif state == "complete":
                    item.setText(clean_text + " [OK]")
                    item.setForeground(QColor("#44cc44"))  # Green
                elif state == "failed":
                    item.setText(clean_text + " [FAIL]")
                    item.setForeground(QColor("#ff4444"))  # Red
                else:
                    item.setText(clean_text)
                    item.setForeground(QColor("#ffffff"))  # White (default)

