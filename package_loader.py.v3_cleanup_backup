class ModelFetchWorker(QThread):
    """Worker thread for fetching available models."""
    finished = Signal(list)
    error = Signal(str)

    def __init__(self, provider: str, base_url: str):
        super().__init__()
        self.provider = provider
        self.base_url = base_url

    def run(self):
        try:
            if self.provider == "ollama":
                models = fetch_ollama_models(self.base_url)
            else:
                models = fetch_openai_models(self.base_url)
            self.finished.emit(models)
        except Exception as e:
            self.error.emit(str(e))


class OllamaWorker(QThread):
    finished = Signal(str)
    error = Signal(str)
    progress = Signal(str)

    def __init__(self, prompt: str, image_paths: List[str], model: str,
                 provider: str, base_url: str):
        super().__init__()
        self.prompt = prompt
        self.image_paths = image_paths
        self.model = model
        self.provider = provider
        self.base_url = base_url

    def run(self):
        try:
            self.progress.emit(f"Connecting to {self.provider}...")
            result = call_ai_provider(
                self.prompt, self.image_paths,
                self.model, self.provider, self.base_url
            )
            self.finished.emit(result)
        except Exception as e:
            self.error.emit(str(e))


