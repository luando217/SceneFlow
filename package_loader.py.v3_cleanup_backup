        self.batch_worker = None

        # RB3.8A: Batch queue for sequential scene analysis
        self._batch_queue = None
        self._batch_running = False

        # Analysis state tracking: scene_id -> status (unanalyzed/processing/complete/failed)
        self._scene_analysis_states = {}

