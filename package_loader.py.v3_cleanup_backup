    # RB3.8B: Runtime lock state management
    def _update_runtime_lock_state(self):
        """Centralized button enable/disable based on _v3_runtime_state.
        
        IDLE:
            Analyze Scene V3 = ENABLED (if scene selected)
            Analyze All Scenes V3 = ENABLED (if scenes exist)
            Cancel V3 = DISABLED
        
        RUNNING_SINGLE:
            Analyze Scene V3 = DISABLED
            Analyze All Scenes V3 = DISABLED
            Cancel V3 = DISABLED
        
        RUNNING_BATCH:
            Analyze Scene V3 = DISABLED
            Analyze All Scenes V3 = DISABLED
            Cancel V3 = ENABLED
        
        Scene browsing is always allowed (no UI lock on scene list).
        """
        state = self._v3_runtime_state
        
        if state == "IDLE":
            self.analyze_v3_btn.setEnabled(self.selected_scene is not None)
            self.analyze_all_v3_btn.setEnabled(len(self.scene_list) > 0 if hasattr(self, 'scene_list') and self.scene_list else False)
            self.cancel_v3_btn.setEnabled(False)
        elif state == "RUNNING_SINGLE":
            self.analyze_v3_btn.setEnabled(False)
            self.analyze_all_v3_btn.setEnabled(False)
            self.cancel_v3_btn.setEnabled(False)
        elif state == "RUNNING_BATCH":
            self.analyze_v3_btn.setEnabled(False)
            self.analyze_all_v3_btn.setEnabled(False)
            self.cancel_v3_btn.setEnabled(True)
    
    # RB3.8C: Batch size change handler
    def _on_batch_size_changed(self, value: int):
        self.batch_size = value
        self._save_config()
    
    def _cancel_v3(self):
        """Cancel current batch or single analysis.
        
        Kills the active OllamaWorker and resets state to IDLE.
        Since cancellation is only enabled during RUNNING_BATCH,
        we handle batch cleanup and cancel the worker if running.
        Worker termination is best-effort via quit().
        """
        # CRITICAL: Use print() as fallback for trace if _log() fails
        def _trace(msg):
            self._log(f"[TRACE_CANCEL] {msg}")
        
        # TRACE: Entry point - always log this to confirm function is called
        has_attr = hasattr(self, 'ollama_worker')
        worker_val = getattr(self, 'ollama_worker', 'MISSING_ATTR')
        worker_exists = worker_val is not None and worker_val != 'MISSING_ATTR'
        worker_running = worker_val.isRunning() if worker_exists else False
        batch_running = self._batch_running
        runtime_state = self._v3_runtime_state if hasattr(self, '_v3_runtime_state') else 'N/A'
        queue_len = len(self._batch_queue) if self._batch_queue else 0
        _trace(f"ENTRY: runtime_state={runtime_state} | _batch_running={batch_running} | queue_len={queue_len} | has_attr={has_attr} | worker_exists={worker_exists} | worker_running={worker_running} | worker_val={worker_val}")
        self._log("[CANCEL] Cancel requested")
        
        # Kill active worker if running
        if has_attr and worker_exists and worker_running:
            self._log("[CANCEL] Terminating active worker")
            # FIX RB3.8E4B: Keep _orphaned_worker reference after wait timeout
            # Worker thread continues synchronous HTTP request - quit() cannot
            # interrupt it. wait(3000) will timeout. Thread continues running.
            # To prevent "QThread: Destroyed while thread is still running" crash,
            # keep reference alive via _orphaned_worker until callback fires.
            try:
                _trace(f"Before quit() - isRunning={worker_val.isRunning()}, worker={worker_val}")
                worker_val.quit()
                _trace(f"After quit() - isRunning={worker_val.isRunning()}")
                wait_result = worker_val.wait(3000)  # Wait up to 3s
                _trace(f"wait(3000) returned={wait_result} | isRunning={worker_val.isRunning()}")
                if not wait_result:
                    # wait() timed out - thread still running, keep reference alive
                    _trace("wait timeout - keeping worker ref in _orphaned_worker")
                    self._orphaned_worker = worker_val
                    self.ollama_worker = None
                    _trace("_orphaned_worker kept alive, self.ollama_worker=None")
                else:
                    # wait() succeeded - thread stopped cleanly
                    _trace(f"Before None assignment - worker={worker_val}")
                    self.ollama_worker = None
                    _trace("After None assignment - worker=None")
            except Exception as e:
                _trace(f"Exception during quit/wait: {e}")
                self._orphaned_worker = worker_val
                self.ollama_worker = None
                _trace("Exception - kept worker ref in _orphaned_worker")
        else:
            _trace(f"Worker branch: has_attr={has_attr} | worker_exists={worker_exists} | worker_running={worker_running}")
            if has_attr and not worker_exists:
                _trace("Worker is None - already cleaned up")
            elif has_attr and not worker_running:
                _trace("Worker exists but isRunning=False - already stopped")
            else:
                _trace(f"No ollama_worker attribute exists")
        
        # Clean up batch state
        self._batch_running = False
        _trace("_batch_running set to False")
        self._batch_queue = None
        _trace("_batch_queue set to None")
        self._batch_current_scene = None
        _trace("_batch_current_scene set to None")
        self._batch_current_scenes = []
        _trace("_batch_current_scenes cleared")
        
        # Reset runtime state to IDLE
        self._v3_runtime_state = "IDLE"
        _trace("_v3_runtime_state set to IDLE")
        self._update_runtime_lock_state()
        
        self.progress_bar.setVisible(False)
        if hasattr(self, '_batch_current_label'):
            self._batch_current_label.setVisible(False)
        if hasattr(self, '_batch_progress_label'):
            self._batch_progress_label.setVisible(False)
        self._log("[CANCEL] Analysis cancelled")
        
        # Restore scene browsing (already enabled, just update buttons)
        self._refresh_scene_list_indicators()
        _trace("Cancel complete - all state reset")

    def _analyze_scene_v3(self):
        """Single-scene V3 runtime using SingleCompiler (_compile_final_prompt).
        
        Reuses existing OllamaWorker, _on_ollama_finished, and save flow.
        Only the prompt source differs from V2 (SingleCompiler vs legacy builder).
        
        RB3.8B: Sets runtime state to RUNNING_SINGLE at entry.
        Restore to IDLE happens in _on_ollama_finished or _on_ollama_error.
        """
        if not self.selected_scene:
            QMessageBox.warning(self, "No Scene", "Please select a scene first.")
            return

        # Lock: prevent re-entry during batch or single analysis
        if self._v3_runtime_state != "IDLE":
            self._log(f"[V3] BLOCKED: Runtime state is {self._v3_runtime_state}")
            return

        # Get the frame path for this scene
        frame_path = self.selected_scene.get('frame') or self.selected_scene.get('path')
        if not frame_path or not os.path.exists(frame_path):
            QMessageBox.warning(self, "No Frame", "No frame available for this scene.")
            return

        scene = self.selected_scene
        self._log(f"[V3] Analyzing scene: {scene['name']}")

        # Compile prompt using SingleCompiler (no scene arg - self-contained)
        final_prompt = self._compile_final_prompt()

        # Show compiled prompt in preview
        self.final_prompt_text.setPlainText(final_prompt)

        img_paths = [frame_path]
        self.ollama_worker = OllamaWorker(
            final_prompt, img_paths, self.model_name,
            self.provider, self.base_url
        )
        self.ollama_worker.progress.connect(self._on_ollama_progress)
        self.ollama_worker.finished.connect(self._on_ollama_finished)
        self.ollama_worker.error.connect(self._on_ollama_error)
        self.ollama_worker.start()

        # RB3.8B: Set runtime lock state
        self._v3_runtime_state = "RUNNING_SINGLE"
        self._update_runtime_lock_state()
        
        self.progress_bar.setVisible(True)
        self._log(f"[V3] Analyzing with {self.provider} model: {self.model_name}...")


    def _build_scene_context(self, scene: dict) -> str:
        """Build SCENE_CONTEXT block for runtime injection.
        
        Includes timeline, subtitle_text[:200], and audio summary
        matching old runtime context assembly.
        """
        audio_type = scene.get("audio_type", "unknown")
        audio_energy = scene.get("audio_energy", 0.0)
        subtitle_text = scene.get("subtitle_text", "")
        has_subtitle = scene.get("has_subtitle", False)
        
        # Subtitle line matching old runtime behavior
        if has_subtitle and subtitle_text:
            subtitle_line = f"- subtitle: {subtitle_text[:200]}\n"
        else:
            subtitle_line = "- subtitle: none\n"
        
        return f"""SCENE CONTEXT
- timeline: scene #{scene['id']} at {scene.get('start_time', 0):.1f}s-{scene.get('end_time', 0):.1f}s
{subtitle_line}- audio summary: type={audio_type}, energy={audio_energy:.2f}
"""

    def _on_ollama_progress(self, msg: str):
        self._log(msg)

    def _on_ollama_finished(self, result: str):
        """Handle analysis completion - auto-save and display results.
        
        RB3.8B: Single mode transitions to IDLE.
        RB3.8E: Batch mode parses N OUTPUT_BLOCKs from single response.
        
        Multi-Scene Flow:
        1. Parse N OUTPUT_BLOCK from response
        2. Save each block to corresponding scene
        3. Update all scene states
        4. Advance batch
        """
        self._log("Analysis complete")
        
        # TRACE: Log callback entry state
        worker_exists = hasattr(self, 'ollama_worker') and self.ollama_worker is not None
        worker_running = self.ollama_worker.isRunning() if worker_exists else False
        batch_running = self._batch_running
        scenes_count = len(self._batch_current_scenes) if hasattr(self, '_batch_current_scenes') and self._batch_current_scenes else 0
        self._log(f"[TRACE_FINISHED] Callback entered | _batch_running={batch_running} | worker_exists={worker_exists} | worker_isRunning={worker_running} | _batch_current_scenes count={scenes_count}")

        # Raw Output tab: full raw model response
        self.raw_output_text.setPlainText(result)

        # RB3.8E: Multi-scene or single-scene handling
        if self._batch_running and len(self._batch_current_scenes) > 1:
            # Multi-scene batch: parse N OUTPUT_BLOCKs
            blocks = self._split_multi_scene_output(result)
            
            if not blocks:
                self._log(f"[BATCH] WARNING: No OUTPUT_BLOCKs found in multi-scene response. Saving raw for {len(self._batch_current_scenes)} scenes")
                # Fallback: save raw output for each scene
                for i, scene in enumerate(self._batch_current_scenes):
                    phase1_path = save_phase1_scene_analysis(
                        self.current_package_dir, scene, result,
                        analysis_model=self.model_name,
                        prompt_version="P1_MULTI"
                    )
                    self._log(f"[BATCH] Saved (raw fallback) scene {i+1}: {phase1_path.name}")
                    self._scene_analysis_states[scene['id']] = "complete"
            else:
                # N OUTPUT_BLOCKs found - save each to corresponding scene
                for scene_idx, block_text in blocks:
                    scene = self._batch_current_scenes[scene_idx]
                    phase1_path = save_phase1_scene_analysis(
                        self.current_package_dir, scene, block_text,
                        analysis_model=self.model_name,
                        prompt_version="P1_MULTI"
                    )
                    self._log(f"[BATCH] Saved scene {scene_idx + 1}/{len(blocks)}: {phase1_path.name}")
                    self._scene_analysis_states[scene['id']] = "complete"
                
                # Handle any scenes that didn't get a block
                saved_indices = {idx for idx, _ in blocks}
                for i, scene in enumerate(self._batch_current_scenes):
                    if i not in saved_indices:
                        self._log(f"[BATCH] WARNING: No OUTPUT_BLOCK for scene {i + 1}: {scene['name']}")
                        self._scene_analysis_states[scene['id']] = "failed"
            
            # Show N scenes saved in Clean Output
            self.clean_output_text.setPlainText(f"[RB3.8E] Processed {len(blocks)} OUTPUT_BLOCKs from {len(self._batch_current_scenes)} scenes\n" if blocks else "")
            
            # Update indicators
            self._refresh_scene_list_indicators()
            
            # RB3.8E1E2: Scene-based progress + ETA
            completed_scenes = self._batch_total_scenes - len(self._batch_queue)
            elapsed = time.time() - self._batch_start_time
            elapsed_str = self._format_duration(elapsed)
            
            # Calculate ETA based on batch performance
            if completed_scenes > 0 and elapsed > 0:
                rate = completed_scenes / elapsed  # scenes per second
                remaining_scenes = len(self._batch_queue)
                eta_seconds = remaining_scenes / rate if rate > 0 else 0
                eta_str = self._format_duration(eta_seconds)
            else:
                eta_str = "calculating..."
            
            percent = int((completed_scenes / self._batch_total_scenes) * 100) if self._batch_total_scenes > 0 else 0
            
            self.progress_bar.setValue(completed_scenes)
            self._batch_progress_label.setText(
                f"{completed_scenes} / {self._batch_total_scenes} scenes ({percent}%) | "
                f"Elapsed: {elapsed_str} | ETA: {eta_str}"
            )
            
            if self._batch_queue:
                # More scenes remain - start next batch
                self._log(f"[BATCH] Multi-scene batch complete. {len(self._batch_queue)} scenes remaining")
                self._analyze_all_next()
            else:
                # All scenes processed
                self._batch_complete()
        else:
            # Single-scene: original flow (batch with 1 scene or single mode)
            if self._batch_running and len(self._batch_current_scenes) == 1:
                # Single scene in batch mode (batch_size=1 or last scene)
                active_scene = self._batch_current_scenes[0]
            else:
                active_scene = self.selected_scene
            
            # Parse the single OUTPUT_BLOCK from response
            clean_block = parse_raw_output(result)
            self.clean_output_text.setPlainText(clean_block)
            
            if active_scene and self.current_package_dir:
                phase1_path = save_phase1_scene_analysis(
                    self.current_package_dir, active_scene, result,
                    analysis_model=self.model_name,
                    prompt_version="P1"
                )
                self._log(f"Saved analysis: {phase1_path}")
                self._scene_analysis_states[active_scene['id']] = "complete"
                
                if self._batch_running:
                    self._refresh_scene_list_indicators()
            
            # RB3.8C: Only hide progress bar in single mode
            if not self._batch_running:
                self.progress_bar.setVisible(False)
            
            # RB3.8B: State transitions
            if self._batch_running:
                self._analyze_all_finished()
            else:
                self._v3_runtime_state = "IDLE"
                self._update_runtime_lock_state()

    def _on_ollama_error(self, error: str):
        """Handle analysis error - continue batch or return to IDLE.
        
        RB3.8B: Single mode transitions to IDLE.
        Batch mode transitions handled in _batch_complete or _analyze_all_finished.
        
        RB3.8E: Multi-scene batch marks ALL current scenes as failed,
        then continues to next batch or completes.
        """
        # TRACE: Log callback entry state
        worker_exists = hasattr(self, 'ollama_worker') and self.ollama_worker is not None
        worker_running = self.ollama_worker.isRunning() if worker_exists else False
        batch_running = self._batch_running
        scenes_count = len(self._batch_current_scenes) if hasattr(self, '_batch_current_scenes') and self._batch_current_scenes else 0
        self._log(f"[TRACE_ERROR] Callback entered | _batch_running={batch_running} | worker_exists={worker_exists} | worker_isRunning={worker_running} | _batch_current_scenes count={scenes_count}")
        self._log(f"Analysis error: {error}")
        
        # RB3.8E: Determine affected scenes
        if self._batch_running:
            if self._batch_current_scenes and len(self._batch_current_scenes) > 1:
                # Multi-scene batch: all N scenes failed
                scene_count = len(self._batch_current_scenes)
                self._log(f"[BATCH] Multi-scene request failed: {scene_count} scenes marked failed")
                QMessageBox.warning(self, "Batch Analysis Error", 
                    f"Failed to analyze batch of {scene_count} scenes: {error}")
                for scene in self._batch_current_scenes:
                    self._scene_analysis_states[scene['id']] = "failed"
                # Clear multi-scene state
                self._batch_current_scenes = []
            elif self._batch_current_scene:
                # Single scene batch mode
                QMessageBox.warning(self, "Analysis Error", f"Failed to analyze scene: {error}")
                self._scene_analysis_states[self._batch_current_scene['id']] = "failed"
                self._batch_current_scene = None
            else:
                # Fallback with generic warning
                QMessageBox.warning(self, "Analysis Error", f"Analysis failed: {error}")
            
            self._refresh_scene_list_indicators()
        else:
            # Single mode
            QMessageBox.warning(self, "Analysis Error", f"Failed to analyze scene: {error}")
        
        # RB3.8C: Only hide progress bar in single mode
        if not self._batch_running:
            self.progress_bar.setVisible(False)
        
        # RB3.8B: State transitions
        if self._batch_running:
            # Batch mode: queue continues, state remains RUNNING_BATCH
            self._analyze_all_finished()
        else:
            # Single mode: return to IDLE
            self._v3_runtime_state = "IDLE"
            self._update_runtime_lock_state()

    # RB3.8A: Analyze All Scenes V3 - Sequential batch processing
    def _analyze_all_scenes_v3(self):
        """Entry point for Analyze All Scenes V3.
        
        Creates queue from scene_list and starts first scene analysis.
        
        RB3.8B: Sets runtime state to RUNNING_BATCH at entry.
        Restore to IDLE happens in _batch_complete or _cancel_v3.
        
        RB3.8C: Respects batch_size from spinbox. Shows progress UI.
        """
        if not self.scene_list:
            QMessageBox.warning(self, "No Scenes", "No scenes to analyze.")
            return
        
        # Lock: prevent re-entry during batch or single analysis
        if self._v3_runtime_state != "IDLE":
            self._log(f"[BATCH] BLOCKED: Runtime state is {self._v3_runtime_state}")
            return
        
        # RB3.8C: Overwrite protection — detect existing analysis files
        if self.current_package_dir:
            analysis_dir = get_analysis_dir(self.current_package_dir)
            existing_files = list(analysis_dir.glob(f"{SCENE_SRC_PREFIX}*.json")) if analysis_dir.exists() else []
            if existing_files:
                reply = QMessageBox.question(
                    self, "Overwrite Analysis?",
                    "Analyze All Scenes V3 will overwrite existing analysis files.\n\nContinue?",
                    QMessageBox.Yes | QMessageBox.No
                )
                if reply == QMessageBox.No:
                    self._log("[BATCH] Overwrite cancelled by user")
                    return

                # Delete all existing analysis files
                for f in existing_files:
                    try:
                        f.unlink()
                    except Exception as e:
                        self._log(f"[BATCH] Failed to delete {f.name}: {e}")
                self._log(f"[BATCH] Deleted {len(existing_files)} existing analysis file(s)")

                # Clear runtime scene status cache
                self._scene_analysis_states.clear()
                self._refresh_scene_list_indicators()

        # RB3.8E: Multi-Scene Request Engine - load ALL scenes into queue
        batch_size = self.batch_size_spin.value()
        self._batch_index = 0  # Track which batch window we're on
        self._batch_total_scenes = len(self.scene_list)  # Track TOTAL for progress
        # RB3.8E: Load ALL scenes into queue for multi-scene processing
        self._batch_queue = list(self.scene_list)  # Copy all scenes
        
        self._batch_running = True
        
        self._log(f"[BATCH] Starting multi-scene batch: {self._batch_total_scenes} scenes (batch_size={batch_size})")
        
        # RB3.8B: Set runtime lock state to RUNNING_BATCH
        self._v3_runtime_state = "RUNNING_BATCH"
        self._update_runtime_lock_state()
        
        # RB3.8C: Show progress UI
        self.progress_bar.setMaximum(self._batch_total_scenes)
        self.progress_bar.setValue(0)
        self.progress_bar.setVisible(True)
        self._batch_current_label.setVisible(True)
        self._batch_progress_label.setVisible(True)
        self._batch_progress_label.setText(f"Completed: 0 / {self._batch_total_scenes}  Remaining: {self._batch_total_scenes}")
        
        # RB3.8E1E2: Initialize start time for ETA
        self._batch_start_time = time.time()
        
        # RB3.8E: Start multi-scene batch processing
        self._log(f"[BATCH] Starting multi-scene request engine")
        self._analyze_all_next()

    def _analyze_all_next(self):
        """RB3.8E: Multi-Scene Request Engine - process N scenes per request.
        
        Takes UP TO batch_size scenes from queue, builds N prompts,
        sends single multi-image worker request.
        
        Flow:
        1. Take N scenes from queue (or remaining scenes)
        2. Build metadata + compile prompt for each
        3. Merge prompts with headers
        4. Build list of N image paths
        5. Send single OllamaWorker request
        6. _on_ollama_finished parses N OUTPUT_BLOCKs
        """
        batch_size = self.batch_size_spin.value()
        
        # RB3.8E: Take UP TO batch_size scenes from queue
        self._batch_current_scenes = []
        self._batch_current_prompts = []
        self._batch_current_images = []
        
        while self._batch_queue and len(self._batch_current_scenes) < batch_size:
            scene = self._batch_queue.pop(0)
            frame_path = scene.get('frame') or scene.get('path')
            
            if not frame_path or not os.path.exists(frame_path):
                self._log(f"[BATCH] SKIP: No frame for {scene['name']}")
                continue
            
            # Build prompt for this scene
            _saved_registry = getattr(self, 'metadata_registry', None) or {}
            _batch_registry = self._build_batch_metadata_registry(scene)
            self.metadata_registry = _batch_registry
            final_prompt = self._compile_final_prompt()
            self.metadata_registry = _saved_registry
            
            self._batch_current_scenes.append(scene)
            self._batch_current_prompts.append(final_prompt)
            self._batch_current_images.append(frame_path)
        
        if not self._batch_current_scenes:
            self._log("[BATCH] ERROR: No valid scenes in batch")
            self._batch_complete()
            return
        
        # Update running label - show first scene for single-scene, N scenes for multi
        if len(self._batch_current_scenes) == 1:
            self._batch_current_label.setText(f"Running: {self._batch_current_scenes[0]['name']}")
        else:
            scene_names = ", ".join([s['name'] for s in self._batch_current_scenes])
            self._batch_current_label.setText(f"Running: [{len(self._batch_current_scenes)} scenes] {scene_names[:50]}...")
        
        # Set RUNNING status for all scenes in batch
        for scene in self._batch_current_scenes:
            self._scene_analysis_states[scene['id']] = "running"
        self._refresh_scene_list_indicators()
        
        # RB3.8E: Merge prompts with headers
        merged_prompt = self._build_batch_prompt_multi_scene()
        
        # Show merged prompt in preview
        self.final_prompt_text.setPlainText(merged_prompt)
        
        self._log(f"[BATCH] Compiling multi-scene batch: {len(self._batch_current_scenes)} scenes")
        
        # Create single worker for all images
        self.ollama_worker = OllamaWorker(
            merged_prompt, self._batch_current_images, self.model_name,
            self.provider, self.base_url
        )
        self.ollama_worker.progress.connect(self._on_ollama_progress)
        self.ollama_worker.finished.connect(self._on_ollama_finished)
        self.ollama_worker.error.connect(self._on_ollama_error)
        self.ollama_worker.start()
        
        self._log(f"[BATCH] Multi-scene worker started with {len(self._batch_current_images)} images")

    def _analyze_all_finished(self):
        """Called after each scene completes (from _on_ollama_finished or _on_ollama_error).
        
        Advances queue to next scene or completes batch.
        
        RB3.8C: Updates progress bar and completion/remaining counts.
        """
        if not self._batch_running:
            return
        
        remaining = len(self._batch_queue)
        done = self._batch_total_scenes - remaining
        
        # RB3.8C: Update progress display
        self.progress_bar.setValue(done)
        self._batch_progress_label.setText(f"Completed: {done} / {self._batch_total_scenes}  Remaining: {remaining}")
        
        if remaining > 0:
            # More scenes in current batch window
            scene = self._batch_queue.pop(0)
            self._batch_current_scene = scene  # RB3.8A2: Batch owns scene, NOT self.selected_scene
            self._log(f"[BATCH] Scene {done + 1}/{self._batch_total_scenes} complete. Next: {scene['name']}")
            self._analyze_all_next()
        else:
            # Current batch window complete - load next batch from scene_list
            self._batch_index += 1
            batch_size = self.batch_size_spin.value()
            start_idx = self._batch_index * batch_size
            end_idx = start_idx + batch_size
            
            if start_idx < len(self.scene_list):
                # More scenes remain - load next batch window
                next_batch = self.scene_list[start_idx:end_idx]
                self._batch_queue = next_batch
                scene = self._batch_queue.pop(0)
                self._batch_current_scene = scene
                self._log(f"[BATCH] Batch {self._batch_index + 1} starting: {scene['name']}")
                self._analyze_all_next()
            else:
                # All scenes processed
                self._batch_complete()

    def _batch_complete(self):
        """Complete batch processing and re-enable UI.
        
        RB3.8C: Sets progress to 100% and hides progress labels.
        """
        self._batch_running = False
        self._batch_queue = None
        self._batch_current_scene = None  # RB3.8A2: Clear batch-owned scene state
        self._log(f"[BATCH] All {self._batch_total_scenes} scenes complete")
        self._log("=" * 40)
        self._log("BATCH ANALYSIS COMPLETE")
        self._log("=" * 40)
        
        # RB3.8C: Set progress to 100%
        self.progress_bar.setValue(self._batch_total_scenes)
        self._batch_current_label.setVisible(False)
        self._batch_progress_label.setVisible(False)
        
        # RB3.8B: Restore buttons via centralized lock state
        self._v3_runtime_state = "IDLE"
        self._update_runtime_lock_state()
        
        # Refresh scene list to show updated states
        self._refresh_scene_list_indicators()
