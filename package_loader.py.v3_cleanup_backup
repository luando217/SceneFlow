        self.batch_size = 5

        # Batch worker state
        self._batch_scene_start = 0  # Start index for current batch
        self._batch_scene_end = 0   # End index (exclusive) for current batch

        # RB3.8B: Runtime lock state - prevents re-entry during analysis
        # Values: "IDLE" | "RUNNING_SINGLE" | "RUNNING_BATCH"
        self._v3_runtime_state = "IDLE"

        # AI Provider settings
        self.provider = DEFAULT_PROVIDER
        self.base_url = DEFAULT_BASE_URL
        self.model_name = DEFAULT_MODEL
        self.available_models = []

