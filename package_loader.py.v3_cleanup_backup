    def _build_batch_prompt_multi_scene(self) -> str:
        """RB3.8E: Merge N scene prompts into single multi-scene request.
        
        Each prompt is wrapped with a scene header and OUTPUT_BLOCK markers.
        The response parser will split by OUTPUT_BLOCK markers.
        """
        delimiter = "\n" + "=" * 60 + "\n"
        merged = ""
        
        for i, prompt in enumerate(self._batch_current_prompts):
            scene = self._batch_current_scenes[i]
            scene_num = i + 1
            header = (
                f"{delimiter}"
                f"## SCENE {scene_num}: {scene['name']}\n"
                f"## Image: {os.path.basename(self._batch_current_images[i])}\n"
                f"{delimiter}\n"
            )
            merged += header + prompt + "\n"
        
        # Add final section
        merged += delimiter
        merged += "Process each scene above and respond with OUTPUT_BLOCK for each.\n"
        merged += delimiter
        
        return merged
    
    def _split_multi_scene_output(self, raw_output: str) -> List[Tuple[int, str]]:
        """RB3.8E: Split multi-scene response into individual OUTPUT_BLOCKs.
        
        Returns list of (scene_index, output_block_text) tuples.
        Scene_index is 0-based, matching _batch_current_scenes.
        
        FIX RB3.8E1E2: Match actual model output format:
        <<OUTPUT_BLOCK>>
        content
        <</OUTPUT_BLOCK>>
        """
        blocks = []
        
        # RB3.8E1E2 FIX: Use correct delimiter format
        import re
        pattern = r'<<OUTPUT_BLOCK>>\s*\n(.*?)\s*<</OUTPUT_BLOCK>>'
        matches = re.findall(pattern, raw_output, re.DOTALL)
        
        if not matches:
            # Fallback: try single output block
            self._log("[BATCH] WARNING: Could not split multi-scene output, treating as single block")
            if raw_output.strip():
                blocks.append((0, raw_output))
        else:
            self._log(f"[BATCH] Parsed {len(matches)} OUTPUT_BLOCKs")
            for i, match in enumerate(matches):
                if i < len(self._batch_current_scenes):
                    blocks.append((i, match.strip()))
                else:
                    self._log(f"[BATCH] WARNING: Extra OUTPUT_BLOCK at index {i}, ignoring")
        
        return blocks

    def _format_duration(self, seconds: float) -> str:
        """RB3.8E1E2: Format seconds to HH:MM:SS or MM:SS string."""
        if seconds < 0:
            return "00:00"
        seconds = int(seconds)
        hours, remainder = divmod(seconds, 3600)
        minutes, secs = divmod(remainder, 60)
        if hours > 0:
            return f"{hours:02d}:{minutes:02d}:{secs:02d}"
        return f"{minutes:02d}:{secs:02d}"

    def _log(self, msg: str):
        ts = datetime.now().strftime("%H:%M:%S")
        self.logs_text.append(f"[{ts}] {msg}")
        self.logs_text.moveCursor(QTextCursor.End)

